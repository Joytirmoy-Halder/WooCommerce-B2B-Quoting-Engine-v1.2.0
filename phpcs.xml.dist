<?xml version="1.0"?>
<ruleset name="WooCommerce B2B Quoting Engine">

  <description>Coding standards for the WooCommerce B2B Quoting Engine.</description>

  <file>.</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
  <exclude-pattern>*/languages/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="basepath" value="."/>
  <arg name="parallel" value="8"/>
  <arg name="cache" value=".phpcs-cache"/>
  <arg value="ps"/>

  <!-- The versions declared in the plugin header. -->
  <config name="minimum_wp_version" value="6.0"/>
  <config name="testVersion" value="7.4-"/>

  <!-- Warnings are still reported (and annotated on pull requests) but only
       errors break the build. -->
  <config name="ignore_warnings_on_exit" value="1"/>

  <rule ref="WordPress">
    <!-- The plugin ships as a single directory of prefixed classes, so the
         file naming convention for class files is not followed. -->
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
  </rule>

  <rule ref="PHPCompatibilityWP"/>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="woo-b2b-quote"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="b2b_quote"/>
        <element value="B2B_Quote"/>
        <element value="B2B_QUOTE"/>
      </property>
    </properties>
  </rule>

  <!-- Direct queries are required: the plugin owns its own table and there is
       no WordPress API for it. Every query uses $wpdb->prepare(). -->
  <rule ref="WordPress.DB.DirectDatabaseQuery">
    <exclude-pattern>*/includes/class-b2b-quote-db.php</exclude-pattern>
    <exclude-pattern>*/uninstall.php</exclude-pattern>
  </rule>

</ruleset>
